name = "family-grocery"
main = "worker/index.ts"
compatibility_date = "2025-08-03"

# The built SPA (Vite output) is served as static assets; the Worker handles /api/*.
# In local dev the Vite server serves the app on :5173 and proxies /api to `wrangler dev`.
[assets]
directory = "./dist"
not_found_handling = "single-page-application"

[[d1_databases]]
binding = "DB"
database_name = "family-grocery"
database_id = "PASTE_DATABASE_ID_HERE"
migrations_dir = "migrations"

# AUTH_SECRET is supplied by .dev.vars locally and `wrangler secret put AUTH_SECRET` in production.

# Rate limiting (per Cloudflare data centre, keyed by client IP in the Worker).
# AUTH_RL guards /api/auth + /api/setup against password guessing.
# API_RL caps every /api/* call so one source can't run up D1 usage.
[[ratelimits]]
name = "AUTH_RL"
namespace_id = "1001"
simple = { limit = 10, period = 60 }

[[ratelimits]]
name = "API_RL"
namespace_id = "1002"
simple = { limit = 200, period = 60 }

# --- demo instance -----------------------------------------------------------
# A second, fully independent deployment for sharing with friends: its own
# Worker (family-grocery-demo.<subdomain>.workers.dev), its own D1 database, its
# own AUTH_SECRET. Nothing is shared with the family instance above.
#
# First-time setup (see README "Deploying a shareable demo"):
#   npm run setup:demo
# Environments don't inherit bindings, so assets / d1 / ratelimits are repeated.
[env.demo]
name = "family-grocery-demo"

[env.demo.assets]
directory = "./dist"
not_found_handling = "single-page-application"

[[env.demo.d1_databases]]
binding = "DB"
database_name = "family-grocery-demo"
database_id = "PASTE_DEMO_DATABASE_ID_HERE"
migrations_dir = "migrations"

[[env.demo.ratelimits]]
name = "AUTH_RL"
namespace_id = "2001"
simple = { limit = 10, period = 60 }

[[env.demo.ratelimits]]
name = "API_RL"
namespace_id = "2002"
simple = { limit = 200, period = 60 }
