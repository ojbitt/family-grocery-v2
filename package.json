{
  "name": "family-grocery-v2",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api -c cyan,magenta \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "vite",
    "dev:api": "wrangler dev --port 8787",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "deploy:demo": "npm run build && wrangler deploy --env demo",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "vue-tsc -b --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply family-grocery --local",
    "db:migrate:remote": "wrangler d1 migrations apply family-grocery --remote",
    "db:migrate:demo": "wrangler d1 migrations apply family-grocery-demo --remote --env demo",
    "seed": "node scripts/seed.mjs",
    "setup": "node scripts/setup.mjs",
    "setup:demo": "node scripts/setup.mjs --env demo",
    "reset-password": "node scripts/reset-password.mjs",
    "reset-password:demo": "node scripts/reset-password.mjs --env demo"
  },
  "dependencies": {
    "@formkit/drag-and-drop": "^0.5.1",
    "idb": "^8.0.3",
    "pinia": "^3.0.3",
    "reka-ui": "^2.5.0",
    "vue": "^3.5.22",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.9.9",
    "@cloudflare/workers-types": "^5.20260903.1",
    "@types/node": "^22.10.5",
    "@vitejs/plugin-vue": "^6.0.1",
    "concurrently": "^9.2.1",
    "typescript": "~5.9.3",
    "vite": "^7.1.7",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.1.1",
    "wrangler": "^4.42.0"
  }
}
